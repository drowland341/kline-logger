<?xml version="1.0" encoding="utf-8"?>
<!-- Logs the app may hand to other apps through the Share sheet. -->
<paths>
    <external-files-path name="logs" path="logs/" />
    <files-path name="internal_logs" path="logs/" />
    <!-- Copies of Documents/KlineLogger logs, so shares keep the real file name. -->
    <cache-path name="shared_logs" path="share/" />
</paths>
